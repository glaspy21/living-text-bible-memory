# Copy to .env.local — never commit real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livingtext
# Optional: database for `npm run test:db` (name must end in _test)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livingtext_test
AUTH_SECRET=                    # random string, e.g. `openssl rand -base64 33`
AUTH_GOOGLE_ID=                 # Google Cloud OAuth client (Web application)
AUTH_GOOGLE_SECRET=             # redirect URI: http://localhost:3000/api/auth/callback/google
ADMIN_EMAILS=glaspy21@gmail.com
STORAGE_DRIVER=local            # local | r2
# LOCAL_STORAGE_DIR=.local-storage   # where the local driver keeps files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ESV_API_KEY=                    # server-only; scope limited to permitted ranges
NEXT_PUBLIC_APP_URL=http://localhost:3000
